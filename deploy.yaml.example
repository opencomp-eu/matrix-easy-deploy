matrix:
  domain: matrix.example.com
  server_name: example.com
  admin_username: admin
  # Homeserver software: synapse (default) or tuwunel
  server_implementation: synapse
proxy:
  type: caddy
  # standalone — this kit runs Caddy on :443 (single-service VPS)
  # integrate — join easydeploy-net; easydeploy-engine owns Caddy (multi-service VPS)
  mode: standalone
  integrate:
    network: easydeploy-net
features:
  registration_enabled: false
  federation_enabled: true
  auto_join:
    rooms: []
    # Example when enabling named welcome rooms (provisioned automatically by apply.sh):
    # rooms:
    #   - alias: welcome
    #     name: Welcome
    #     topic: Start here for server info and introductions
    #     message: |
    #       Welcome to Example Chat! We hope you enjoy your time here.
    #     handover:
    #       - community-admin
    #     federated: false   # local-server public room; not open to remote homeservers
    #   - '#announce:example.com'
    synapse:
      rooms_for_guests: false
  element:
    enabled: true
    domain: element.example.com
    brand: Example Chat
    default_theme: light
    disable_custom_urls: false
    disable_guests: true
    disable_3pid_login: false
    disable_login_language_selector: false
    branding:
      auth_header_logo_url: https://assets.example.com/element/logo.svg
      welcome_background_url:
        - https://assets.example.com/element/bg-1.jpg
        - https://assets.example.com/element/bg-2.jpg
      auth_footer_links:
        - text: Support
          url: https://example.com/support
    embedded_pages:
      home_url: https://assets.example.com/element/home.html
      welcome_url: https://assets.example.com/element/welcome.html
      login_for_welcome: false
    integrations:
      enabled: true
    room_directory:
      servers:
        - example.com
    labs:
      show_settings: false
      features: {}
    ui_features:
      feedback: false
      widgets: true
      voip: true
      registration: false
      password_reset: true
      create_public_rooms: true
    extra_config: {}
  calls:
    enabled: true
    livekit_domain: livekit.example.com
    # Element Call SPA used by Element Web for outbound MatrixRTC calls.
    # Defaults to https://call.element.io; your LiveKit backend comes from rtc_foci.
    # When guest_access is enabled, element_call.url defaults to the self-hosted SPA.
    # element_call_url: https://call.element.io
    guest_access:
      enabled: false
      # Element Call SPA domain (meeting links like https://call.example.com/roomId)
      domain: call.example.com
      # Guest homeserver domain — MXIDs (@alice:guest.example.com) and client API
      server_name: guest.example.com
  local_login_enabled: true
  sso:
    enabled: false
    # provider: kanidm     # set by the wizard when a local Kanidm is detected
    # managed: true        # set false to ignore engine/Kanidm OIDC sidecars
    # default_login: sso   # Kanidm: skip the local+SSO chooser (MAS redirects to Kanidm). Set chooser to show both.
    providers: []
    # Example provider (Google):
    # - id: 01HFVBY12TMNTYTBV8W921M5FA  # assigned by apply.sh if omitted
    #   name: Google
    #   issuer: https://accounts.google.com/
    #   client_id: your-client-id
    #   client_secret: your-client-secret
    #   allow_registration: true
modules:
  hookshot:
    enabled: false
    domain: hookshot.example.com
  whatsapp_bridge:
    enabled: false
    admin_username: admin
  slack_bridge:
    enabled: false
    admin_username: admin

# Origins allowed to iframe Element (Bulwark webmail). On a same-VPS engine
# install this is filled from bulwark.domain; set it here for standalone or extras.
# embed:
#   frame_ancestors:
#     - https://webmail.example.com
backup:
  enabled: false
  repository:
    type: local              # local | sftp
    path: /var/backups/med-kit   # local: absolute dir on this host; sftp: dir on the remote host
    # sftp only — fill these in when type: sftp:
    # host: backup.example.com
    # user: borg
    # port: 22
    # ssh_key_path: /root/.ssh/borg_backup   # must exist on this host
    # host_key_check: true   # true -> accept-new, false -> no
    # Borg repository encryption, applied only when the repo is first created:
    #   repokey (default) — new repos are encrypted with the BORG_PASSPHRASE
    #     secret that `bash apply.sh` generates in .matrix-easy-deploy/secrets.yaml.
    #   none — unencrypted repos. Pre-rework MED_Backup repos are unencrypted:
    #     set encryption: none so repo creation stays a silent no-op and those
    #     archives keep restoring.
    encryption: repokey
  schedule:
    enabled: false
    calendar: "*-*-* 03:00:00"
    persistent: true
  retention:
    keep_daily: 7
    keep_weekly: 4
    keep_monthly: 6
    keep_yearly: 0
