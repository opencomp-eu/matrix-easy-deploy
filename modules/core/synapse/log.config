version: 1

formatters:
  precise:
    format: "%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s"
  audit_json:
    class: synapse.logging.TerseJsonFormatter

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
  audit_file:
    class: logging.handlers.WatchedFileHandler
    formatter: audit_json
    filename: /var/lib/easydeploy-audit/synapse.jsonl
    delay: true

loggers:
  synapse.storage.SQL:
    # Uncomment the line below to log all SQL queries — very verbose.
    # level: DEBUG
    level: WARNING
  synapse.handlers.auth:
    level: INFO
    handlers: [audit_file]
    propagate: false
  synapse.rest.client.login:
    level: INFO
    handlers: [audit_file]
    propagate: false
  synapse.handlers.room_member:
    level: INFO
    handlers: [audit_file]
    propagate: false

root:
  level: WARNING
  handlers: [console]

disable_existing_loggers: false

disable_existing_loggers: false
